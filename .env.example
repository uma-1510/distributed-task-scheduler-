# Copy to .env and adjust as needed. Every value below is the default the
# app falls back to if the variable isn't set, except DATABASE_URL's
# password, which you should change from the placeholder in real use.

DATABASE_URL=postgresql://scheduler_user:scheduler_pass@localhost:5432/scheduler_db
REDIS_URL=redis://localhost:6379

GRPC_PORT=50051
COORDINATOR_HOST=localhost
COORDINATOR_PORT=8000

# coordinator/database.py connection pool sizing (see issue #3)
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=20

# worker/main.py bounded job-execution concurrency (see issue #9)
WORKER_MAX_THREADS=10

# CORS: origin(s) the dashboard/ frontend is served from, comma-separated
DASHBOARD_ORIGINS=http://localhost:5173

# Worker-only, set per-container in docker-compose.yml — not needed for a
# single local run
WORKER_ID=worker-1
WORKER_ADDRESS=localhost

FROM python:3.12-slim

# Without this, Python fully buffers stdout when it's not a TTY (i.e.
# always, in a container), so `print()` calls — including every
# [heartbeat]/[worker]/[executor] log line — never reach `docker compose
# logs` in anything close to real time. Noticed while trying to verify
# issue #2's heartbeat-timing fix against a live container and finding the
# worker's logs were completely empty.
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY proto/ ./proto/
COPY worker/ ./worker/
COPY common/ ./common/
COPY coordinator/ ./coordinator/

RUN python -m grpc_tools.protoc \
    -I./proto \
    --python_out=./proto \
    --grpc_python_out=./proto \
    proto/scheduler.proto && \
    sed -i 's/import scheduler_pb2 as scheduler__pb2/from proto import scheduler_pb2 as scheduler__pb2/' proto/scheduler_pb2_grpc.py

EXPOSE 50051
CMD ["python", "worker/main.py"]
